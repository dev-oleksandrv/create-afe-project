{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push -fu*)",
      "Bash(git push * -uf*)",
      "Bash(git push * -fu*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * +*)"
    ],
    "ask": [
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push --prune*)",
      "Bash(git push * --prune*)",
      "Bash(git push * :*)",
      "Bash(git push * refs/tags/*)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh workflow run *)",
      "Bash(gh api *DELETE*)",
      "Bash(gh api *graphql*)",
      "Bash(gh api */rulesets*)",
      "Bash(gh api */protection*)",
      "Bash(scripts/protect-branch.sh *)",
      "Bash(./scripts/protect-branch.sh *)",
      "Bash(bash scripts/protect-branch.sh *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)",
      "Bash(bun publish *)",
      "Bash(cargo publish *)",
      "Bash(poetry publish *)",
      "Bash(uv publish *)",
      "Bash(twine upload *)",
      "Bash(gem push *)",
      "Bash(dotnet nuget push *)",
      "Bash(docker push *)",
      "Bash(podman push *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-check.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-dispatch.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-dispatch.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
