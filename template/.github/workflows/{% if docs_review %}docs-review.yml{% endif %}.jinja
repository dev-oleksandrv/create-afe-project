# Documentation review of pull requests (docs/documentation-rules.md, section 7). Claude reads
# the diff, checks documentation
# changes against docs/documentation-rules.md and code or contract changes for missing
# documentation updates, and posts findings as PR comments. It proposes only; it changes nothing.
# It is a sensor with one pass (docs/contributing.md, section 6): it runs when the pull request
# opens or leaves draft, and a push does not run it again.
# Needs the Claude GitHub App installed on the repository and the CLAUDE_CODE_OAUTH_TOKEN secret.
name: docs-review

on:
  pull_request:
    types: [opened, ready_for_review]

concurrency:
  group: docs-review-{{ '${{' }} github.event.pull_request.number {{ '}}' }}
  cancel-in-progress: true

permissions:
  contents: read
  pull-requests: read
  issues: read
  id-token: write

jobs:
  review:
    if: {{ '${{' }} !github.event.pull_request.draft {{ '}}' }}
    runs-on: {{ '${{' }} fromJSON(vars.CI_RUNS_ON || '{{ ci_runs_on_default }}') {{ '}}' }}
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v7.0.1
        with:
          fetch-depth: 0

      - name: Diff against the base branch
        env:
          BASE_REF: {{ '${{' }} github.base_ref {{ '}}' }}
        run: git diff "origin/$BASE_REF...HEAD" > "$RUNNER_TEMP/pr.diff"

      # track_progress forces the action's tag mode: the prompt is appended to the action's own
      # review prompt as custom instructions instead of being passed verbatim, so Claude Code does
      # not expand the leading "/docs-review" itself. Claude invokes the skill through the Skill
      # tool, which a headless run denies unless it is allowed here.
      - name: Review
        uses: anthropics/claude-code-action@v1.0.268
        with:
          claude_code_oauth_token: {{ '${{' }} secrets.CLAUDE_CODE_OAUTH_TOKEN {{ '}}' }}
          track_progress: "true"
          prompt: "/docs-review {{ '${{' }} github.event.pull_request.number {{ '}}' }} {{ '${{' }} runner.temp {{ '}}' }}/pr.diff"
          claude_args: '--allowedTools "Skill(docs-review *),mcp__github_inline_comment__create_inline_comment" --disallowedTools "Edit,Write,MultiEdit,NotebookEdit,Bash" --max-turns 40'
