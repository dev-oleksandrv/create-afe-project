# Path classes of this project (docs/documentation-rules.md, sections 8 and 9): one
# "<class> <glob>" per line, a shell glob relative to the repository root, in which * also matches
# /. A path takes the highest class among the lines that match it and the template's built-in
# ones (approval for the rules, the map, ADRs on main, and the generated manifest, answers file,
# and settings). A path that nothing
# matches is low when it is Markdown, otherwise normal. This file belongs to the project; a
# change to it is class approval.
#   approval  the owner approves the edit first: the protect hook asks, a headless run is denied
#   high      with the dual_review module, the Santa loop before the pull request
#   gate      listed under "Gate files" in the pull request, reviewed by the owner after the merge
#   normal    with the dual_review module, one reviewer before the pull request
#   low       no reviewer before the pull request

# Secrets and tools with irreversible effects.
approval .env
approval .env.*
approval *.pem
approval *.key

# Security, access, data migrations, money, public contracts. Add the project's own, such as
# policy or limits.
high *auth/*
high *security/*
high *secrets/*
high *migrations/*
high *billing/*
high *payments/*
high contracts/*

# Gates: workflows, the project's checks and Stop hooks, and the harness settings.
gate .github/workflows/*
gate scripts/checks.d/*
gate .claude/hooks/project/*
gate .claude/harness.conf

# Gates of any stack: dependency updates, pre-commit hooks, task runners, and tool versions. The
# `*/` lines gate the files of Make, just, and Task in subdirectories too, and `*.mk` every file
# with that extension; tool versions and mise are gated at the root only.
gate .github/dependabot.y*ml
gate renovate.json*
gate .github/renovate.json*
gate .renovaterc*
gate .pre-commit-config.yaml
gate Makefile
gate */Makefile
gate makefile
gate */makefile
gate GNUmakefile
gate */GNUmakefile
gate *.mk
gate justfile
gate */justfile
gate Justfile
gate */Justfile
gate .justfile
gate */.justfile
gate Taskfile.y*ml
gate */Taskfile.y*ml
gate Taskfile.dist.y*ml
gate */Taskfile.dist.y*ml
gate taskfile.y*ml
gate */taskfile.y*ml
gate taskfile.dist.y*ml
gate */taskfile.dist.y*ml
gate .tool-versions
gate mise.toml
gate mise.*.toml
gate .mise.toml
gate .mise.*.toml
gate mise/config.toml
gate .mise/config.toml
gate .config/mise.toml
gate .config/mise/*

# Gates of each ecosystem: dependency manifests and lock files, toolchain and package-source
# files, and the configuration of linters, test runners, coverage, and mutation testing. Every
# block is seeded; a glob that matches nothing costs nothing. The `*/` lines cover the modules of
# a monorepo: every manifest, lock file, toolchain file, and package-source file that a module can
# have of its own; `settings.gradle*` counts as one, since it names the repositories of its build.
# Workspace files such as `go.work`, `pnpm-workspace.yaml`, and `melos.yaml`, wrappers, tool
# configuration, and `global.json`, a name that other files use too, are gated at the root only.
# A glob that starts with `*` matches at any depth.

