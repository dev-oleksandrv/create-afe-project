# Secret scanning of every change (docs/documentation-rules.md, section 7): gitleaks reads the
# commits of a pull request, or of a push to main, and fails on a secret it finds. The binary is
# downloaded at a pinned version and checked against its SHA-256, so the project installs nothing.
# A false positive is listed by its fingerprint in .gitleaksignore; project rules go into
# .gitleaks.toml at the repository root. GitHub's own secret scanning and push protection
# (Settings, Code security) add a second layer at no cost for public repositories.
name: secret-scan

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  gitleaks:
    runs-on: {{ '${{' }} fromJSON(vars.CI_RUNS_ON || '{{ ci_runs_on_default }}') {{ '}}' }}
    env:
      GITLEAKS_VERSION: 8.30.1
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0

      - name: install gitleaks
        run: |
          case "$(uname -m)" in
            x86_64) arch=x64; sum=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb ;;
            aarch64|arm64) arch=arm64; sum=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080 ;;
            *) echo "no gitleaks build for $(uname -m)"; exit 1 ;;
          esac
          file="gitleaks_${GITLEAKS_VERSION}_linux_${arch}.tar.gz"
          curl -sSfL -o "$RUNNER_TEMP/$file" "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/$file"
          echo "$sum  $RUNNER_TEMP/$file" | sha256sum -c -
          tar -xzf "$RUNNER_TEMP/$file" -C "$RUNNER_TEMP" gitleaks

      - name: scan the commits of the change
        env:
          BASE_REF: {{ '${{' }} github.base_ref {{ '}}' }}
          BEFORE: {{ '${{' }} github.event.before {{ '}}' }}
        run: |
          if [ -n "$BASE_REF" ]; then range="origin/$BASE_REF..HEAD"
          elif [ -n "$BEFORE" ] && [ "$BEFORE" != 0000000000000000000000000000000000000000 ]; then range="$BEFORE..HEAD"
          else range=HEAD; fi
          "$RUNNER_TEMP/gitleaks" git --redact --no-banner --exit-code 1 --log-opts="--no-merges $range" .
