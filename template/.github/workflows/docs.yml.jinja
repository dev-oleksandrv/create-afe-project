# Documentation, template, and project checks: the CI side of scripts/check.sh (AGENTS.md,
# section 6). markdownlint-cli2 runs through its official action with the same configuration
# file, and the link check is scripts/check-links.mjs, as locally; decision records are checked
# by the `decisions` workflow.
name: docs

on:
  push:
    branches: [main]
  pull_request:
  # By hand, or by a workflow: a pull request opened with GITHUB_TOKEN starts no run by itself.
  workflow_dispatch:

permissions:
  contents: read

jobs:
  check:
    # Set the repository variable CI_RUNS_ON (a JSON array of runner labels) to run elsewhere
    # without editing this template-owned file.
    runs-on: {{ '${{' }} fromJSON(vars.CI_RUNS_ON || '{{ ci_runs_on_default }}') {{ '}}' }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      # Node.js for npx, which scripts/check-docs.sh and project checks use (README.md, Checks).
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: lts/*

      - name: markdownlint-cli2
        uses: DavidAnson/markdownlint-cli2-action@696eb3f2509270d7b882d2aa68347bc676e7af34 # v25.0.0

      - name: links
        run: node scripts/check-links.mjs

      - name: template integrity
        run: scripts/check-template.sh

      - name: project checks
        run: scripts/check-project.sh
