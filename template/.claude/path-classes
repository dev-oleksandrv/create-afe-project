# Path classes of this project: one "<class> <glob>" per line, a shell glob relative to the
# repository root, in which * also matches /. Two classes:
#   high  two reviewers and up to REVIEW_MAX_ROUNDS review rounds in /create-pr
#   gate  listed under "Gate files" in the pull request; the owner reviews it after the merge
# A path that nothing matches is normal when it is not Markdown (one reviewer, one round), and
# low when it is Markdown or a generated file (no reviewer).

# Security, access, data migrations, money, public contracts.
high *auth/*
high *security/*
high *secrets/*
high *migrations/*
high *billing/*
high *payments/*
high contracts/*

# Gates: workflows, the project's checks and Stop hooks, and the harness settings. Add the gate
# files of the stack: manifests, lock files, toolchain, linter, formatter, type checker, test
# runner, and coverage configuration.
gate .github/workflows/*
gate scripts/checks.d/*
gate .claude/hooks/project/*
gate .claude/harness.conf
gate .claude/settings.project.json
gate .claude/path-classes
