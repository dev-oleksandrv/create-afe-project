# Path classes of this repository: one "<class> <glob>" per line, a shell glob relative to the
# repository root, in which * also matches /. Two classes:
#   high  two reviewers and up to REVIEW_MAX_ROUNDS review rounds in /create-pr
#   gate  listed under "Gate files" in the pull request; the owner reviews it after the merge
# A path that nothing matches is normal when it is not Markdown (one reviewer, one round).

# Security, access, data migrations, money, public contracts.
high *auth/*
high *security/*
high *secrets/*
high *migrations/*
high *billing/*
high *payments/*
high contracts/*

# Gates: workflows, the template tests, the self-sync, the release, and the harness settings.
gate .github/workflows/*
gate scripts/checks.d/*
gate .claude/hooks/project/*
gate .claude/harness.conf
gate .claude/settings.project.json
gate .claude/path-classes
gate scripts/sync-self.sh
gate scripts/tag-release.sh
gate package.json
gate package-lock.json
gate .changeset/config.json
