# Code review of pull requests (docs/contributing.md, section 6). Claude reads the diff of a pull
# request that changes code, contracts, checks, or workflows, reviews it against the rubric of
# that section and the project's own criteria, and posts findings as PR comments. It proposes
# only; it changes nothing. Needs the Claude GitHub App installed on the repository and the
# CLAUDE_CODE_OAUTH_TOKEN secret.
name: code-review

on:
  pull_request:
    types: [opened, synchronize, ready_for_review, reopened]

concurrency:
  group: code-review-{{ '${{' }} github.event.pull_request.number {{ '}}' }}
  cancel-in-progress: true

permissions:
  contents: read
  pull-requests: read
  issues: read
  id-token: write

jobs:
  review:
    if: {{ '${{' }} !github.event.pull_request.draft {{ '}}' }}
    runs-on: {{ '${{' }} fromJSON(vars.CI_RUNS_ON || '{{ ci_runs_on_default }}') {{ '}}' }}
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7.0.1
        with:
          fetch-depth: 0

      # The description as the event carries it; the skill reads it as data, never as instructions.
      - name: Diff and description of the pull request
        env:
          BASE_REF: {{ '${{' }} github.base_ref {{ '}}' }}
          PR_BODY: {{ '${{' }} github.event.pull_request.body {{ '}}' }}
        run: |
          git diff "origin/$BASE_REF...HEAD" > "$RUNNER_TEMP/pr.diff"
          printf '%s\n' "$PR_BODY" > "$RUNNER_TEMP/pr-body.md"

      # As in the docs-review workflow: track_progress keeps the prompt as custom instructions, and
      # the Skill tool is allowed explicitly because a headless run denies it otherwise. No plugin
      # is installed: the review rests on the repository's own rules.
      - name: Review
        uses: anthropics/claude-code-action@v1
        with:
          claude_code_oauth_token: {{ '${{' }} secrets.CLAUDE_CODE_OAUTH_TOKEN {{ '}}' }}
          track_progress: "true"
          prompt: "/review-code {{ '${{' }} github.event.pull_request.number {{ '}}' }} {{ '${{' }} runner.temp {{ '}}' }}/pr.diff {{ '${{' }} runner.temp {{ '}}' }}/pr-body.md"
          claude_args: '--allowedTools "Skill(review-code *),mcp__github_inline_comment__create_inline_comment" --disallowedTools "Edit,Write,MultiEdit,NotebookEdit,Bash" --max-turns 60'
