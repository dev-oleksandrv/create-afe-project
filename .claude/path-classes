# Path classes of this repository (docs/documentation-rules.md, sections 8 and 9): one
# "<class> <glob>" per line, relative to the repository root; a path takes the highest class
# among the lines that match it and the template's built-in ones. This file belongs to the
# project; a change to it is class approval.

# The product of this repository: every generated project's rules come from here.
approval template/*
approval src/*
approval bin/*

# Secrets.
approval .env
approval .env.*

# Gates: workflows, the template tests, the self-sync, and the harness settings.
gate .github/workflows/*
gate scripts/checks.d/*
gate scripts/sync-self.sh
gate .claude/harness.conf
gate package.json
gate package-lock.json
gate .changeset/config.json
gate scripts/tag-release.sh

# Gates of any stack: dependency updates, pre-commit hooks, task runners, and tool versions. The
# `*/` lines gate the files of Make, just, and Task in subdirectories too, and `*.mk` every file
# with that extension; tool versions and mise are gated at the root only.
gate .github/dependabot.y*ml
gate renovate.json*
gate .github/renovate.json*
gate .renovaterc*
gate .pre-commit-config.yaml
gate Makefile
gate */Makefile
gate makefile
gate */makefile
gate GNUmakefile
gate */GNUmakefile
gate *.mk
gate justfile
gate */justfile
gate Justfile
gate */Justfile
gate .justfile
gate */.justfile
gate Taskfile.y*ml
gate */Taskfile.y*ml
gate Taskfile.dist.y*ml
gate */Taskfile.dist.y*ml
gate taskfile.y*ml
gate */taskfile.y*ml
gate taskfile.dist.y*ml
gate */taskfile.dist.y*ml
gate .tool-versions
gate mise.toml
gate mise.*.toml
gate .mise.toml
gate .mise.*.toml
gate mise/config.toml
gate .mise/config.toml
gate .config/mise.toml
gate .config/mise/*
