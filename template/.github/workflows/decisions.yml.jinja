# Decision-record integrity and merge readiness (docs/documentation-rules.md, sections 5 and 7).
# Same script as the local Stop hook
# .claude/hooks/stop-check-decisions.sh. Without branch protection a failing job
# does not block the merge: it tells the owner that merging now is a deliberate exception.
name: decisions

on:
  pull_request:
    # `edited` reruns the readiness check when the description or the base branch changes.
    types: [opened, synchronize, reopened, edited, ready_for_review]

concurrency:
  group: decisions-{{ '${{' }} github.event.pull_request.number {{ '}}' }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  integrity:
    runs-on: {{ '${{' }} fromJSON(vars.CI_RUNS_ON || '{{ ci_runs_on_default }}') {{ '}}' }}
    steps:
      - uses: actions/checkout@v7.0.1
        with:
          fetch-depth: 0

      - name: records on the base branch change only their status line
        env:
          BASE_REF: {{ '${{' }} github.base_ref {{ '}}' }}
        run: scripts/check-decisions.sh --base "origin/$BASE_REF"

  readiness:
    runs-on: {{ '${{' }} fromJSON(vars.CI_RUNS_ON || '{{ ci_runs_on_default }}') {{ '}}' }}
    steps:
      - uses: actions/checkout@v7.0.1
        with:
          fetch-depth: 0

      # The description goes through the environment, never into the command line.
      # Readiness reads the description and the diff (docs/contributing.md, section 3). A pull
      # request that a workflow opened with GITHUB_TOKEN has a generated description: only its
      # decision records are checked.
      - name: description ready, no added record still proposed
        env:
          BASE_REF: {{ '${{' }} github.base_ref {{ '}}' }}
          PR_BODY: {{ '${{' }} github.event.pull_request.body {{ '}}' }}
          PR_AUTHOR: {{ '${{' }} github.event.pull_request.user.login {{ '}}' }}
        run: |
          if [ "$PR_AUTHOR" = 'github-actions[bot]' ]; then
            echo "== a pull request opened by a workflow: its generated description is not checked"
            scripts/check-decisions.sh --base "origin/$BASE_REF" --ready
          else
            printf '%s\n' "$PR_BODY" > "$RUNNER_TEMP/pr-body.md"
            scripts/check-decisions.sh --base "origin/$BASE_REF" --ready --pr-body "$RUNNER_TEMP/pr-body.md"
          fi
